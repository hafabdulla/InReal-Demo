{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-drift.mjs\" start 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-drift.mjs\" stop 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking the docs are current"
          }
        ]
      }
    ]
  }
}
